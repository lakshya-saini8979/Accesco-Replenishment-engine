# PostgreSQL Connection Configuration (Copy this file to .env and update credentials)
# Local Docker Compose default:
DATABASE_URL=postgresql+asyncpg://accesco:accesco_local_pass@localhost:5432/accesco_local
POSTGRES_USER=accesco
POSTGRES_PASSWORD=accesco_local_pass
POSTGRES_DB=accesco_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Set to "true" during pytest/multi-loop unit testing to avoid loop-bound pool reuse
PG_NULLPOOL=false

# Operational Policy Defaults
QUIET_HOURS_START=21
QUIET_HOURS_END=8
COOLDOWN_DAYS=3
DAILY_FREQUENCY_CAP=1
